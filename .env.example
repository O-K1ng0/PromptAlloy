# ══════════════════════════════════════════════════════════════
#  PromptAlloy — LLM Configuration
# ══════════════════════════════════════════════════════════════
#  This app works with ANY OpenAI-compatible API provider.
#  Just set your API key, base URL, and model name below.
# ══════════════════════════════════════════════════════════════

# ── STEP 1: Paste your API key ────────────────────────────────
OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# ── STEP 2: Set your provider's base URL ──────────────────────
#  OpenRouter (free): https://openrouter.ai/api/v1/chat/completions
#  NVIDIA NIM:        https://integrate.api.nvidia.com/v1/chat/completions
#  Groq:              https://api.groq.com/openai/v1/chat/completions
#  Together AI:       https://api.together.xyz/v1/chat/completions
#  OpenAI:            https://api.openai.com/v1/chat/completions
#  Local (Ollama):    http://localhost:11434/v1/chat/completions
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ── STEP 3: Choose your model ─────────────────────────────────
#  OpenRouter:   openrouter/auto (auto-picks best free model)
#  NVIDIA NIM:   deepseek-ai/deepseek-v4-flash
#  Groq:         llama-3.3-70b-versatile
#  Together AI:  meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#  OpenAI:       gpt-4o-mini
#  Ollama:       llama3
OPENROUTER_MODEL=openrouter/auto

# ── Advanced (usually no need to change) ──────────────────────
LLM_PROVIDER=openrouter

# ── Optional: Gemini as fallback provider ─────────────────────
#  If the primary provider fails with a server error, PromptAlloy
#  can automatically fall back to Google Gemini.
#  Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
